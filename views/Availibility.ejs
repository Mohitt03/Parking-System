<!DOCTYPE html>
<html lang="en">

<head>
    <title>Park My Spot</title>

    <link rel="stylesheet" href="..\css\Availibility.css" type="text/css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Make sure you put this AFTER Leaflet's CSS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>

<body>

    <body>

        <section class="sec1">


            <div class="sec1-div1">
                <% if (parkings.length===0) { %>
                    <h1>Item not found</h1>
                    <% } else { %>
                        <% parkings.forEach(parking=> { %>

                            <div class="sec1-div2">
                                <div class="inner-head-div1">
                                    <div class="head1">
                                        <h1>
                                            <%=parking.address%>
                                        </h1>
                                    </div>
                                    <div class="head2">
                                        <h1>
                                            <%=parking.total_spot %> spots
                                        </h1>
                                    </div>

                                </div>
                                <div class="inner-head-div2">
                                    <div>
                                        <p class="sec1-div1-p">
                                            ₹<%=parking.Reservation_Price%><br>
                                                1 hours
                                        </p>
                                    </div>

                                    <div>
                                        <h3 class="sec1-div1-h3 link2"><a href="/user/booking/<%=parking._id %>"
                                                class="sec1-div1-h3-a">Park
                                                here </a></h3>
                                        <h3 class="sec1-div1-h3 link2"><a href="/user/seemore/<%=parking._id %>"
                                                class="sec1-div1-h3-a">See More
                                            </a></h3>
                                    </div>
                                </div>
                                <% console.log(parking.Location); %>

                            </div>
                            <% }); %>
                                <% } %>
            </div>
            <div>

                <div id="map"></div>
            </div>

        </section>

        <script>
            var map = L.map('map').setView([21.186393, 72.824685], 14);


            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            var parkings = <%- JSON.stringify(parkings || []) %>;


            var markers = [];

            parkings.forEach(parking => {
                var marker = L.marker([parking.Location.lng, parking.Location.lat])
                    .addTo(map)
                // .bindPopup(parking.name || "Parking Spot");

                markers.push(marker);
            });

            // Example: open first marker’s popup
            markers[0].openPopup();

        </script>
    </body>

</html>