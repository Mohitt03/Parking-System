<!DOCTYPE html>
<html lang="en">

<head>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous" />
  <!-- Google Icons Link -->
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,400,0,0">
  <!-- Google Fonts Link For Icons -->
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />


  <link rel="stylesheet" type="text/css" href="/css/darshan.css">
  <!-- <link rel="stylesheet" type="text/css" href="../public/css/darshan.css"> -->

  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Signin</title>
</head>

<body>



  <div class="container-fluid">
    <div class="row">
      <div class="col-md-6 d-none d-md-block">
        <div class="register-page-img">
          <!-- <img src="https://images.unsplash.com/photo-1562426509-5044a121aa49?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MzV8fHBhcmtpbmd8ZW58MHx8MHx8fDA%3D" alt="Signup Image" class="img-fluid">
           -->
          <swiper-container class="mySwiper" space-between="30" centered-slides="true" autoplay-delay="5500"
            effect="fade" autoplay-disable-on-interaction="false">
            <swiper-slide> <img
                src="https://images.unsplash.com/photo-1562426509-5044a121aa49?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MzV8fHBhcmtpbmd8ZW58MHx8MHx8fDA%3D"
                alt="Signup Image" class="img-fluid">
            </swiper-slide>
            <swiper-slide> <img src="https://images.pexels.com/photos/1000633/pexels-photo-1000633.jpeg" alt="parking-2"
                class="img-fluid"> </swiper-slide>
            <swiper-slide><img src="https://images.pexels.com/photos/9799756/pexels-photo-9799756.jpeg"
                class="img-fluid" alt="park-3"></swiper-slide>
          </swiper-container>

        </div>
      </div>

      <div class="col-md-6">
        <div class="form-box signup ">
          <div class="form-head">
            <h2>JOIN PARKSMART AND TAKE <br> CONTROL OF PARKING</h2>
            <h6>Simplify parking with real-time booking, <br> secure access, and easy management.</h6>
          </div>
          <div class="form-content">
            <form action="/user/signin" method="POST">



              <div class="input-field">
                <label for="exampleInputEmail1">Email Address</label>
                <input id="exampleInputEmail1" type="email" name="email" placeholder="email" required
                  autocomplete="email">
              </div>

              <div class="input-field">
                <label for="exampleInputPassword1">Password </label>
                <input type="password" name="password" placeholder="password" required id="exampleInputPassword1">
              </div>
              <button>Login</button>
              <!-- <button type="submit">Sign Up</button> -->
            </form>
            <div class="bottom-link">
              Already have an account?
              <a href="signup" id="signup-link">Signup</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


  <%- include('./partials/scripts') %>
</body>

</html>