
<header class="w-100">


  <nav class="container">
    <div class="row">
      <div class="col-lg-3 d-flex justify-content-center align-items-center ">
        <div class="logo-container">
          <img src="\images\image.png">
          <a href="/" class="logo">Parking System</a>
        </div>
      </div>
      <div class="col-lg-6 d-flex align-items-center justify-content-center ">
        <div class="navbar-links-container">
          <ul class="menu-links">
            <li><a href="/">Home</a></li>
            <li><a href="/user/explore">Explore</a></li>

            <li><a class="alast" href="#Contact">Contact us</a></li>
          
          </ul>

        </div>
      </div>
      <div class="col-lg-3 d-flex justify-content-center align-items-center">

        <div class="">
          <% if (locals.user) { %>
            <div class="nav-btn-grp">

            </div>
            <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown"
              aria-expanded="false">
              <img class="img-fluid profile-pic" src="<%- locals.user.profileImg.profileImageURL %>" alt="" srcset="">
              <h6><%- locals.user.fullName %></h6>
            </button>
            <ul class="dropdown-menu">

              <li> <a href="/user/reservations" class="logout  dropdown-item">Reservations</a></li>
              <li> <a href="/user/logout" class="logout dropdown-item">LOG OUT </a></li>
            </ul>
            <% } else {%>
              <div class="nav-btn-grp">
                <a class="logout " href="/user/signup"> <button class="book register-btn  ">Register</button> </a>
                <a class="logout " href="/user/signin"> <button class="book login-btn  ">Login</button> </a>
              </div>
              <% } %>
        </div>
      </div>
    </div>
    </div>


</header>

<!-- Site loader: full-screen overlay shown while page resources load -->
<div id="site-loader" class="site-loader">
  <div class="site-loader__inner">
    <div class="spinner" aria-hidden="true"></div>
    <span class="site-loader__text">Loading...</span>
  </div>
</div>
